# Server
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Postgres (used by docker-compose)
POSTGRES_USER=ulybka
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ulybka
POSTGRES_PORT=5432
DATABASE_URL=postgres://ulybka:change_me_strong_password@localhost:5432/ulybka

# Clinic
CLINIC_NAME=Улыбка столицы
TIMEZONE=Asia/Almaty

# OpenAI (required)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# WhatsApp provider: green-api | baileys | none
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=green-api
WHATSAPP_AUTH_DIR=./data/whatsapp-auth

# GREEN-API (recommended for free/dev)
GREEN_API_URL=https://7201.api.green-api.com
GREEN_API_ID_INSTANCE=your_id_instance
GREEN_API_TOKEN_INSTANCE=your_api_token_instance

# Google Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_PATH=./secrets/google-oauth-token.json

# Force re-seed catalog (wipes appointments!) — leave unset/false in production
# FORCE_SEED=false
